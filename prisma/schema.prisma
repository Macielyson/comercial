generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id            String   @id @default(cuid())
  nome          String
  quantidade    Int
  precoVenda    Float
  precoCompra   Float
  descricao     String?
  imagemUrl     String?
  unidadeMedida String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}